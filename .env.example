# ── Copia este archivo a backend/.env y rellena los valores ──

DATABASE_URL=postgresql+asyncpg://aros:aros_pass@postgres:5432/aros_db
DATABASE_SYNC_URL=postgresql+psycopg2://aros:aros_pass@postgres:5432/aros_db
REDIS_URL=redis://redis:6379/0

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=tu_usuario_github

# Opcional: Vercel (si no, usa GitHub Pages)
VERCEL_TOKEN=

# Opcional: Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx

# Opcional: Amazon Associates
AMAZON_ASSOCIATE_TAG=tu-tag-20

CORS_ORIGINS=http://localhost:3000
DEBUG=false
